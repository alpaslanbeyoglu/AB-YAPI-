rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'alpaslan.beyoglu@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Users may read only their own license. Only the verified administrator
    // may list, create, update, or delete license records.
    match /licenses/{email} {
      allow get: if isVerifiedAdmin()
        || (isSignedIn()
          && request.auth.token.email_verified == true
          && request.auth.token.email == email);
      allow list: if isVerifiedAdmin();
      allow create, update, delete: if isVerifiedAdmin();
    }

    // Every document below a user root belongs exclusively to that Firebase UID.
    match /users/{userId}/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Deny all other documents by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}