rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin & License rules
    match /licenses/{email} {
      // Admin (you) can read/write any license
      allow read, write: if request.auth != null && request.auth.token.email == 'alpaslan.beyoglu@gmail.com';
      // Regular users can only read their own license document
      allow read: if request.auth != null && request.auth.token.email.lower() == email.lower();
    }

    // Zero-Trust security: Users can only read and write their own data
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
